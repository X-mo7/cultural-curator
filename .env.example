# Docker Compose reads this file when copied to .env.
# For local Python commands: set -a; source .env; set +a
CULTURAL_CURATOR_MODE=demo
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=cultural_curator_demo
# For Mistral, set CULTURAL_CURATOR_MODE=mistral and use a separate database
# (e.g. cultural_curator), then seed its catalogue. Only Mistral needs an API key:
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
